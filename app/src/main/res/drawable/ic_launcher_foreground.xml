<?xml version="1.0" encoding="utf-8"?>
<!-- The eBikeTrader mark: the same bike-and-bolt art the website draws in
     icon.tsx and the iOS app renders, redrawn as an Android vector.
     
     The source art is a 48-unit square. The group scales it by 1.35 (64.8dp)
     and centres it, keeping everything inside the 66dp circle a round mask
     leaves visible — at the full 72dp safe-zone width the wheels would clip
     on circular launchers.
     
     Circles are drawn as arc paths because vector drawables have no circle
     element, unlike the SVG this is ported from. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.35"
        android:scaleY="1.35"
        android:translateX="21.6"
        android:translateY="21.6">

        <!-- Rear wheel -->
        <path
            android:pathData="M6,33 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
            android:strokeColor="#5FC4D6"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Front wheel -->
        <path
            android:pathData="M28,33 a7,7 0 1,0 14,0 a7,7 0 1,0 -14,0"
            android:strokeColor="#5FC4D6"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Frame -->
        <path
            android:pathData="M13,33 L23,33 L19,14 L31,14 L35,33 M23,33 L31,14"
            android:strokeColor="#5FC4D6"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Saddle -->
        <path
            android:pathData="M15.5,13 L22.5,13"
            android:strokeColor="#5FC4D6"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Handlebars -->
        <path
            android:pathData="M31,14 L31,9 M27,9 L33,9"
            android:strokeColor="#5FC4D6"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- Bolt -->
        <path
            android:pathData="M25.9,5.5 L7.4,27.7 L24,27.7 L22.2,42.5 L40.7,20.3 L24,20.3 Z"
            android:fillColor="#FBBF24"
            android:strokeColor="#0E7490"
            android:strokeWidth="1.3"
            android:strokeLineJoin="round" />
    </group>
</vector>
